# Cấu hình máy chủ NV4 (Cổng mặc định: 3000)
PORT=3000
DB_PATH=./data/dongnai_flood.sqlite
UPLOAD_DIR=./uploads

# Chế độ dữ liệu và AI
DATA_MODE=demo
AI_MODE=mock

# Tích hợp dịch vụ AI NV3 (Máy chủ NV3 chạy trên cổng mặc định: 3001)
AI_ANALYZE_URL=http://localhost:3001/api/analyze-flood
AI_API_KEY=
AI_TIMEOUT_MS=20000

# Địa chỉ công khai, CORS & Trust Proxy
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cấu hình Trust Proxy (Express):
# - Mặc định ngoài production (development/test): 'loopback' (chỉ tin X-Forwarded-* khi socket đến từ 127.0.0.1/::1, tức tunnel cloudflared/ngrok chạy local)
# - Mặc định trên production: false (bắt buộc đặt tường minh, ví dụ: TRUST_PROXY=1 hoặc TRUST_PROXY=10.0.0.1/8)
# TRUST_PROXY=false
